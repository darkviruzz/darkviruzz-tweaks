{
  "id": "darkviruzz-tweaks",
  "title": "Darkviruzz Tweaks & QoL",
  "description": "A personal collection of quality-of-life tweaks for our gaming table. Every feature is individually toggleable and off by default (vanilla behaviour unless you opt in). Targets Foundry VTT v14+ and the dnd5e system 5.x / 6.x (D&D 2024); the other features are system-agnostic.",
  "version": "1.10.0",
  "authors": [
    {
      "name": "Markus Walther",
      "url": "https://github.com/darkviruzz"
    }
  ],
  "compatibility": {
    "minimum": "14",
    "verified": "14"
  },
  "socket": true,
  "persistentStorage": true,
  "esmodules": [
    "scripts/main.js"
  ],
  "styles": [
    "styles/settings.css",
    "styles/ability-score-prominence.css",
    "styles/spell-effect-autoapply.css",
    "styles/file-picker-preview.css",
    "styles/token-art-picker.css",
    "styles/savage-attacker.css",
    "styles/weapon-mastery.css",
    "styles/token-tools.css",
    "styles/token-status-icons.css",
    "styles/token-formation.css",
    "styles/rsr-attack-targets.css"
  ],
  "languages": [
    {
      "lang": "en",
      "name": "English",
      "path": "lang/en.json"
    },
    {
      "lang": "de",
      "name": "Deutsch",
      "path": "lang/de.json"
    }
  ],
  "url": "https://github.com/darkviruzz/darkviruzz-tweaks",
  "readme": "https://github.com/darkviruzz/darkviruzz-tweaks#readme",
